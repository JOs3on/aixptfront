# Client (Vite) — only VITE_* variables reach the browser
VITE_MAKE_WEBHOOK_URL=

# Vapi voice demos — public IDs, safe to ship to the browser
VITE_VAPI_PUBLIC_KEY=
VITE_VAPI_CONCESSIONNAIRE_AGENT_ID=
VITE_VAPI_DENTAIRE_AGENT_ID=
VITE_VAPI_HVAC_AGENT_ID=
# Voice is not provisioned for the law-firm niche yet (chat demo only)
VITE_VAPI_AVOCAT_AGENT_ID=
# E.164 numbers assigned to each assistant. Leave blank to hide the phone CTA.
VITE_DEMO_PHONE_CONCESSIONNAIRE=
VITE_DEMO_PHONE_DENTAIRE=
VITE_DEMO_PHONE_HVAC=
VITE_DEMO_PHONE_AVOCAT=

# Server only — never prefix with VITE_ (these keys must stay private)
VAPI_PRIVATE_KEY=
GEMINI_API_KEY=
# Primary demo model (cheapest strong Flash Lite)
GEMINI_MODEL=gemini-3.1-flash-lite
# Optional comma-separated fallbacks used only if the primary is overloaded
GEMINI_MODEL_FALLBACKS=gemini-3.5-flash-lite,gemini-flash-lite-latest
